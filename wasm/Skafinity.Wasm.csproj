<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The web toy's engine. This compiles the SAME MusicGen.cs + VibeCodec.cs that the s&box
    library (../sbox-library) ships — shared source, not copies — to WebAssembly, so the web
    and the game run identical composition code. Only Exports.cs (the [JSExport] boundary,
    the analog of the old emcc bindings.cpp) is web-specific.

    Build: `make` (→ dotnet publish into build/). Needs the wasm-tools workload:
      dotnet workload install wasm-tools
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SkafinityWasm</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- AOT-compile to native wasm: synthesis is a heavy per-sample loop, far faster AOT
         than interpreted. Comment out for quicker dev builds (composition is identical). -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <!-- Don't pre-compress the bundle. The SDK otherwise writes a .br and a .gz beside every
         file in _framework, and NOTHING here consumes them: .gitignore excludes them from the
         committed web/_framework, `make release` excludes them from the tarball, and
         docker/nginx.conf serves the bundle with no gzip_static/brotli_static. Measured at 22 s
         of a 113 s publish — a fifth of the build, for output that is deleted or ignored
         everywhere it lands. Turn it back on the day something actually serves precompressed
         assets. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- The algorithmic source of truth, shared verbatim with the s&box library. The glob is
         deliberate: Code/Engine/ is the framework-free engine and NOTHING else lives there, so
         the folder boundary is what stops this build ever pulling in the s&box-only
         SkafinityPlayer.cs / Code/UI/. Add an engine file, it compiles; put a Sandbox.* type in
         Engine/ and both targets break, which is the intent. -->
    <Compile Include="../sbox-library/Skafinity/Code/Engine/**/*.cs" />
  </ItemGroup>

</Project>
