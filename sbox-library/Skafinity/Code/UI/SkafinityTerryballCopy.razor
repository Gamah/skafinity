@using System
@using Sandbox
@using Sandbox.UI
@namespace Skafinity
@inherits PanelComponent
@implements Component.DontExecuteOnServer

@*
	TEMPORARY — terryball's WorldSettings screen, copied here to be looked at. Delete it with the
	rest of the slider scaffolding.

	It is `../terryball/Code/WorldSettings.razor` with the WIRING taken out and NOTHING else changed:
	the markup, the inline styles and the <style> block below are that file's, character for
	character where they survive at all. What is gone is only what cannot come along — TerryAvatar
	(so the modal is always up, rather than gated on walking to a podium), WorldPrefs (local fields
	instead of cookies) and WorldTheme (its colours pasted as literals, since the values are what
	matter here and not where they come from).

	The point is a control that is KNOWN to draw in the project it came from, standing in this one
	unchanged. If its sliders are visible here, something about the skafinity board is at fault and
	this file is the diff to read. If they are as invisible as everything else, then the difference
	is the project rather than the panel, and no markup will fix it.
*@

<root style="position: absolute; width: 100%; height: 100%; pointer-events: none;
             font-family: Poppins, sans-serif; color: white;">

	<div style="position: absolute; width: 100%; height: 100%;
	            flex-direction: column; align-items: center; justify-content: center;">
		<div style="pointer-events: all; flex-direction: column; width: 620px;
		            padding: 28px 32px; border-radius: 18px;
		            background-color: @BgSolid;
		            border-width: 2px; border-color: @Border;">

			<div style="font-size: 28px; font-weight: 800; letter-spacing: 1px; margin-bottom: 6px;
			            color: @Text;">
				WORLD SETTINGS
			</div>
			<div style="font-size: 15px; margin-bottom: 20px; color: @TextFaint;">
				terryball's screen, wiring removed. If these sliders draw, the panel is not the problem.
			</div>

			<div style="height: 2px; margin: 12px 0px; background-color: @Divider;"></div>

			<div style="font-size: 17px; font-weight: 800; letter-spacing: 1px; margin-bottom: 4px;
			            color: @AccentCss;">
				SKY BRIGHTNESS — @Pct( SkyBrightness )%
			</div>
			<div style="font-size: 14px; margin-bottom: 8px; color: @TextDim;">
				Dims or lifts the daylight over the alley. 100% is the lighting as built.
			</div>
			<SliderControl class="wslider" Min="@(0.25f)" Max="@(1.75f)"
			               Step="@(0.01f)" Value="@SkyBrightness" ShowValueTooltip="@(false)"
			               OnValueChanged="@SetSkyBrightness"></SliderControl>

			<div style="height: 2px; margin: 12px 0px; background-color: @Divider;"></div>

			<div style="font-size: 17px; font-weight: 800; letter-spacing: 1px; margin-bottom: 4px;
			            color: @AccentCss;">
				VOICE RANGE — ROAMING — @( $"{VoiceRangeRoaming:0}u" )
			</div>
			<div style="font-size: 14px; margin-bottom: 8px; color: @TextDim;">
				How far you hear other players talk. Your ears only — it doesn't change how far
				anybody hears you.
			</div>
			<SliderControl class="wslider" Min="@(200f)" Max="@(3000f)"
			               Step="@(10f)" Value="@VoiceRangeRoaming" ShowValueTooltip="@(false)"
			               OnValueChanged="@SetVoiceRange"></SliderControl>

			<div style="height: 2px; margin: 12px 0px; background-color: @Divider;"></div>

			<div style="flex-direction: row; align-items: center;">
				<div style="flex-grow: 1;"></div>
				<div style="pointer-events: all; padding: 12px 26px; border-radius: 9px;
				            font-size: 17px; font-weight: 700; cursor: pointer;
				            background-color: rgba(255,255,255,0.12); color: @Text;"
				     onclick=@Close>
					CLOSE
				</div>
			</div>
		</div>
	</div>
</root>

@*
	The ONLY compiled styles on this screen: the slider's layout. Every colour stays inline above because a
	compiled block is baked at build time and cannot follow the runtime theme — see WorldTheme. SliderControl
	brings its own chrome from the engine's base stylesheet, so all it needs here is a size and pointer input.
*@
<style>
	.wslider {
		width: 100%;
		height: 24px;
		margin-bottom: 4px;
		pointer-events: all;
	}

	/* Belt and braces with ShowValueTooltip="false": the built-in bubble renders as a bare black box
	   (hardcoded background in the base scss) and the heading above already prints the value. */
	.wslider .value-tooltip {
		display: none;
	}
</style>

@code
{
	// WorldTheme, as literals. The screen reads a runtime static there; the values are what matter here.
	const string BgSolid = "rgb(20,17,14)";
	const string Border = "rgba(255,255,255,0.16)";
	const string Divider = "rgba(255,255,255,0.10)";
	const string Text = "rgba(255,255,255,0.92)";
	const string TextDim = "rgba(255,255,255,0.70)";
	const string TextFaint = "rgba(255,255,255,0.50)";
	const string AccentCss = "rgb(232,160,58)";

	// WorldPrefs, as fields. The screen reads cookies there; nothing here needs to persist.
	float SkyBrightness = 1f;
	float VoiceRangeRoaming = 900f;

	void SetSkyBrightness( float v ) => SkyBrightness = v;
	void SetVoiceRange( float v ) => VoiceRangeRoaming = v;

	static int Pct( float v ) => (int)MathF.Round( v * 100f );

	// The real screen asks the avatar to close it; there is no avatar here, so it removes its own rig.
	void Close() => GameObject?.Destroy();

	protected override int BuildHash() => HashCode.Combine( SkyBrightness, VoiceRangeRoaming );
}
